# Docker Compose 用的环境变量
# 复制成 .env.docker 后填写：cp .env.docker.example .env.docker

# ---- 必填 ----
# 说话人分离必需。到 https://huggingface.co/settings/tokens 生成（Read 权限），
# 并接受这三个模型的用户协议：
#   pyannote/speaker-diarization-community-1
#   pyannote/speaker-diarization-3.1
#   pyannote/segmentation-3.0
HF_TOKEN=

# ---- 门户 ----
# 首次启动创建的超级管理员（数据库已有用户后不再生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 同时往 ASR 发几个任务（GPU 只有一个时保持 1）
WORKER_CONCURRENCY=1

# ---- ASR ----
# RTX 50xx 用 blackwell，其他 NVIDIA 卡用 latest
ASR_IMAGE_TAG=latest
DEFAULT_MODEL=large-v3
# 启动时预加载模型可以省掉首次请求的等待，但会拖慢容器启动
PRELOAD_MODEL=
COMPUTE_TYPE=float16
BATCH_SIZE=16
MAX_FILE_SIZE_MB=1000
# 空闲多少秒后从显存卸载模型。0 = 常驻不卸载（省事但一直占显存）
# 600 = 10 分钟没任务就把显存还回去，下次请求重新加载约 10-20 秒
MODEL_KEEP_ALIVE_SECONDS=600

# ---- 说话人分离 ----
# 按说话人变化重新切分段落。中文会被切在字中间（见 AGENTS.md 7.1），
# 但多人对话不重切会整段只标一个人。按需取舍。
RESEGMENT_BY_SPEAKER=false

# pyannote 模型。community-1 是默认；3.1 是更早更保守的版本，可用来对比。
# 注意：官方镜像把模型名写死了，这个变量生效靠 docker/asr-service/ 的本地补丁。
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# 短于这个秒数的停顿会被填充，从而合并左右两个说话人 turn。
# 实际测下来这是唯一起作用的分离参数（2.0 能把 turn 从 100 压到 30）。
DIARIZE_MIN_DURATION_OFF=2.0

# 聚类阈值。留空用模型默认。
# 实测对低码率单声道音频完全不敏感（0.5 和 0.9 结果一样），别指望它。
DIARIZE_CLUSTERING_THRESHOLD=

# ASR 模型缓存目录。默认复用同级目录 whisperx-asr-service/.cache，
# 免得在容器里重下 3GB；改成命名卷（如 whisperx-cache）就是干净环境。
ASR_CACHE_DIR=../whisperx-asr-service/.cache

# ---- 标点 ----
PUNC_MODEL=ct-punc
